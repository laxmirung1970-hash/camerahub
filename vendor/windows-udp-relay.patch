@@ -0,0 +1,48 @@
+package cs2
+
+import (
+ "bufio"
+ "encoding/binary"
+ "encoding/json"
+ "errors"
+ "io"
+ "net"
+ "os"
+ "sync"
+ "time"
+)
+
+type udpSocket interface {
+ net.Conn
+ ReadFromUDP([]byte) (int,*net.UDPAddr,error)
+ WriteToUDP([]byte,*net.UDPAddr) (int,error)
+}
+
+// Only enabled on the Windows Docker profile. Other deployments use UDP directly.
+func dialRelayUDP(host string) (udpSocket,error) {
+ conn,err:=net.DialTimeout("tcp",os.Getenv("CAMERAHUB_UDP_RELAY"),3*time.Second)
+ if err!=nil {return nil,errors.New("camera UDP relay unavailable")}
+ conn.SetDeadline(time.Now().Add(3*time.Second))
+ hello:=map[string]string{"host":host,"token":os.Getenv("CAMERAHUB_UDP_TOKEN")}
+ if json.NewEncoder(conn).Encode(hello)!=nil {conn.Close();return nil,errors.New("camera UDP relay handshake failed")}
+ var ack [1]byte
+ if _,err=io.ReadFull(conn,ack[:]);err!=nil||ack[0]!=1 {conn.Close();return nil,errors.New("camera UDP relay rejected destination")}
+ conn.SetDeadline(time.Time{})
+ return &relayUDP{Conn:conn,reader:bufio.NewReader(conn),ip:net.ParseIP(host)},nil
+}
+
+type relayUDP struct { net.Conn; reader *bufio.Reader; ip net.IP; writeMu sync.Mutex }
+func(c *relayUDP) ReadFromUDP(b []byte)(int,*net.UDPAddr,error){
+ var header [4]byte
+ if _,err:=io.ReadFull(c.reader,header[:]);err!=nil{return 0,nil,err}
+ size:=int(binary.BigEndian.Uint16(header[2:]));port:=int(binary.BigEndian.Uint16(header[:2]))
+ if size<4||size>2048||size>len(b)||port<1024 {return 0,nil,errors.New("invalid camera relay frame")}
+ _,err:=io.ReadFull(c.reader,b[:size]);return size,&net.UDPAddr{IP:c.ip,Port:port},err
+}
+func(c *relayUDP) WriteToUDP(b []byte,addr *net.UDPAddr)(int,error){
+ if len(b)<4||len(b)>2048||!addr.IP.Equal(c.ip)||addr.Port<1024||addr.Port>65535{return 0,errors.New("invalid relay destination")}
+ c.writeMu.Lock();defer c.writeMu.Unlock()
+ frame:=make([]byte,len(b)+4);binary.BigEndian.PutUint16(frame[:2],uint16(addr.Port));binary.BigEndian.PutUint16(frame[2:4],uint16(len(b)));copy(frame[4:],b)
+ for len(frame)>0 {n,err:=c.Conn.Write(frame);if err!=nil{return 0,err};if n==0{return 0,io.ErrShortWrite};frame=frame[n:]}
+ return len(b),nil
+}
