+package cs2
+import("bufio";"encoding/binary";"io";"net";"testing";"time")
+func TestCameraRelayFramingAndBounds(t *testing.T){
+ a,b:=net.Pipe();defer a.Close();defer b.Close();a.SetDeadline(time.Now().Add(time.Second));b.SetDeadline(time.Now().Add(time.Second))
+ c:=&relayUDP{Conn:a,reader:bufio.NewReader(a),ip:net.ParseIP("172.16.0.202")}
+ go func(){b.Write([]byte{0x28,0x3a,0,4,0xf1,0x41,0,0})}()
+ p:=make([]byte,1200);n,addr,err:=c.ReadFromUDP(p);if err!=nil||n!=4||addr.Port!=10298||!addr.IP.Equal(c.ip){t.Fatal("datagram framing")}
+ done:=make(chan []byte,1);go func(){r:=make([]byte,8);io.ReadFull(b,r);done<-r}()
+ if _,err=c.WriteToUDP([]byte{0xf1,0x30,0,0},addr);err!=nil{t.Fatal(err)}
+ if binary.BigEndian.Uint16((<-done)[:2])!=10298{t.Fatal("lost negotiated port")}
+ if _,err=c.WriteToUDP([]byte{0xf1,0x30,0,0},&net.UDPAddr{IP:net.ParseIP("172.16.0.203"),Port:32108});err==nil{t.Fatal("accepted other camera")}
+ go func(){b.Write([]byte{0x28,0x3a,0xff,0xff})}()
+ if _,_,err=c.ReadFromUDP(p);err==nil{t.Fatal("accepted oversized packet")}
+}
