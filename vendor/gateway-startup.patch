+package app
+import ("encoding/json";"sync/atomic")
+type startupState struct { stage atomic.Value }
+var Startup = &startupState{}
+func(s *startupState) Set(stage string) { s.stage.Store(stage) }
+func(s *startupState) MarshalJSON()([]byte,error) { value,_:=s.stage.Load().(string);return json.Marshal(value) }
