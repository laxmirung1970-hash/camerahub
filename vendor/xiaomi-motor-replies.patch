+++ b/pkg/xiaomi/miss/camerahub_motor_test.go
@@ -0,0 +1,22 @@
+package miss
+import (
+ "bytes"
+ "encoding/binary"
+ "math/bits"
+ "testing"
+ "github.com/AlexxIT/go2rtc/pkg/xiaomi/crypto"
+)
+func TestCameraHubMotorReplyFraming(t *testing.T) {
+ key:=bytes.Repeat([]byte{0x42},32)
+ expected:=[]byte(`{"angle":49,"elevation":51,"ret":0}`)
+ plain:=binary.BigEndian.AppendUint32(nil,0x113)
+ plain=append(plain,expected...); plain=append(plain,0)
+ encrypted,err:=crypto.Encode(plain,key); if err!=nil {t.Fatal(err)}
+ for _,outer:=range []uint32{cmdEncoded,bits.ReverseBytes32(cmdEncoded)} {
+  cmd,payload,err:=normalizeCommandReply(outer,encrypted,key)
+  if err!=nil||cmd!=0x113||!bytes.Equal(payload,expected) {t.Fatal("encrypted motor framing failed")}
+ }
+ cmd,payload,err:=normalizeCommandReply(bits.ReverseBytes32(0x113),append(expected,0),key)
+ if err!=nil||cmd!=0x113||!bytes.Equal(payload,expected) {t.Fatal("plain motor framing failed")}
+ if _,_,err=normalizeCommandReply(cmdEncoded,[]byte{1,2},key);err==nil {t.Fatal("accepted malformed encrypted reply")}
+}
