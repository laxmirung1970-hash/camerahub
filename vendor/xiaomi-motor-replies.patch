 //}
+
+type commandReply struct { cmd uint32; data []byte }
+
+// CS2 frames carry network-order command IDs. Encrypted replies include a
+// four-byte inner ID and camera JSON may end in NUL bytes.
+func normalizeCommandReply(cmd uint32, data, key []byte) (uint32, []byte, error) {
+ if cmd == cmdEncoded || bits.ReverseBytes32(cmd) == cmdEncoded {
+  if len(data)<8 { return 0,nil,errors.New("xiaomi: truncated encrypted reply") }
+  decoded,err:=crypto.Decode(data,key)
+  if err!=nil { return 0,nil,err }
+  if len(decoded)<4 { return 0,nil,errors.New("xiaomi: truncated command reply") }
+  cmd=binary.BigEndian.Uint32(decoded[:4]); data=decoded[4:]
+ } else if cmd>0xffff && bits.ReverseBytes32(cmd)<=0xffff {
+  cmd=bits.ReverseBytes32(cmd)
+ }
+ return cmd, bytes.TrimRight(data,"\x00"),nil
+}
