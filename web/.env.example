# Public HTTPS origin of the home backend (Tailscale Funnel / Cloudflare Tunnel), no trailing slash.
# Leave empty for same-origin deployments (Windows live, NAS). Baked in at build time by Vite,
# so redeploy after changing it on Vercel. The backend must list the web origin in APP_ALLOWED_ORIGINS.
VITE_API_BASE=
# "lite" builds the view-only family app (opened as https://<lite origin>/#<share token>).
# Leave empty for the full UI. Deploy it as a second Vercel project with the same root directory.
VITE_VARIANT=
# Origin of that lite deployment, used by the full UI to print share links (settings → ทีวีและอุปกรณ์).
VITE_SHARE_ORIGIN=
